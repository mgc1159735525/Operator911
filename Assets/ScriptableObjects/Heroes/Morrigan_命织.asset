  backstory: "\u51FA\u751F\u65F6\u4FBF\u88AB\u53E4\u8001\u6B7B\u4EA1\u4E4B\u795E\u6807\u8BB0\u7684\u9884\u8A00\u8005\uFF0C\u53CC\u773C\u80FD\u770B\u89C1\u6240\u6709\u751F\u7269\u7684\u547D\u8FD0\u4E1D\u7EBF\uFF0C\u6BCF\u6B21\u5927\u89C4\u6A21\u9884\u77E5\u90FD\u4F1A\u8BA9\u5979\u79BB\u75AF\u72C2\u66F4\u8FD1\u4E00\u6B65\u3002"
